# Τοπικές ρυθμίσεις για Docker Compose.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=library
KEYCLOAK_CLIENT_ID=library-api
KEYCLOAK_CLIENT_SECRET=library-api-dev-secret
API_PORT=8000
FRONTEND_URL=http://localhost:8000/
COOKIE_SECURE=false
RABBITMQ_USER=library
RABBITMQ_PASSWORD=library
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://library:library@localhost:5672/
RABBITMQ_EXCHANGE=library.events
RABBITMQ_QUEUE=library.node-red
NODE_RED_PORT=1880
NODE_RED_CREDENTIAL_SECRET=library-node-red-dev-secret
TZ=Europe/Athens
MINIO_ROOT_USER=library
MINIO_ROOT_PASSWORD=library-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_AUDIT_BUCKET=library-audit
