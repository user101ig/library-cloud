{
  "realm": "library",
  "enabled": true,
  "displayName": "Library Cloud",
  "loginTheme": "library",
  "internationalizationEnabled": false,
  "supportedLocales": ["en"],
  "defaultLocale": "en",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "library-api",
      "name": "Library API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "library-api-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/auth/callback",
        "http://127.0.0.1:8000/auth/callback",
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "http://127.0.0.1:8000"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Can manage all library system operations."
      },
      {
        "name": "librarian",
        "description": "Can manage books and loans."
      },
      {
        "name": "reader",
        "description": "Can browse books."
      }
    ]
  },
  "users": [
    {
      "username": "test-admin",
      "email": "test-admin@library.local",
      "firstName": "Test",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "test-librarian",
      "email": "test-librarian@library.local",
      "firstName": "Test",
      "lastName": "Librarian",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Librarian123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "librarian"
      ]
    },
    {
      "username": "test-reader",
      "email": "test-reader@library.local",
      "firstName": "Test",
      "lastName": "Reader",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Reader123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "reader"
      ]
    }
  ]
}
